# 상대 경로는 프로젝트 루트 기준
WL_VIDEO_DIR=data/raw/videos
WL_DATASET_DIR=outputs/dataset
WL_RUNS_DIR=outputs/runs
WL_WEIGHTS=models/yolo26n.pt
# 학습 장치: mps(Mac), cpu, 0(CUDA 첫 GPU). 비어 있으면 자동 선택.
WL_TRAIN_DEVICE=
PYTORCH_ENABLE_MPS_FALLBACK=1

# 새 MP4용 모델 상위 폴더. 비워 두면 기존 실험 가중치 경로를 사용한다.
# models/pytorch/에 배포 가중치를 준비한 뒤 WL_MODEL_DIR=models 로 지정한다.
WL_MODEL_DIR=
# 새 MP4의 분석 결과를 실행별로 저장할 위치
WL_OUTPUT_DIR=outputs/file_analysis
# FastAPI 추론 장치. Mac에서 MPS를 사용하려면 mps로 지정한다.
WL_API_DEVICE=cpu
